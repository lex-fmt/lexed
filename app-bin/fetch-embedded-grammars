#!/usr/bin/env bash
set -euo pipefail

# Downloads tree-sitter parser WASMs and highlight queries for the
# languages listed in the embedded-grammars manifest. The manifest is
# extracted from the tree-sitter-lex release tarball by fetch-deps, so
# fetch-deps must run first.
#
# Layout per language:
#   resources/embedded-grammars/<lang>/parser.wasm
#   resources/embedded-grammars/<lang>/highlights.scm

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
GRAMMARS_DIR="$APP_DIR/resources/embedded-grammars"
MANIFEST="$APP_DIR/resources/embedded-grammars.json"
STAMP_DIR="$APP_DIR/.deps"

IF_MISSING=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --if-missing) IF_MISSING=true; shift ;;
    -h|--help)
      echo "Usage: $(basename "$0") [--if-missing]"
      exit 0 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

if [[ ! -f "$MANIFEST" ]]; then
  echo "error: $MANIFEST not found — run fetch-deps first" >&2
  exit 1
fi

command -v jq >/dev/null 2>&1 || { echo "error: jq is required" >&2; exit 1; }

curl_opts=(-fsSL)
token="${GITHUB_TOKEN:-${GH_TOKEN:-}}"
if [[ -n "$token" ]]; then
  curl_opts+=(-H "Authorization: Bearer $token")
fi

count=$(jq '.grammars | length' "$MANIFEST")

# Fast path: if every grammar stamp matches, skip entirely
if $IF_MISSING; then
  all_present=true
  for i in $(seq 0 $((count - 1))); do
    lang=$(jq -r ".grammars[$i].name" "$MANIFEST")
    version=$(jq -r ".grammars[$i].version" "$MANIFEST")
    stamp="$STAMP_DIR/grammar-${lang}.stamp"
    if [[ ! -f "$stamp" ]] || [[ "$(cat "$stamp")" != "$version" ]]; then
      all_present=false
      break
    fi
  done
  if $all_present; then
    echo "embedded grammars already installed, skipping"
    exit 0
  fi
fi

mkdir -p "$STAMP_DIR"

for i in $(seq 0 $((count - 1))); do
  lang=$(jq -r ".grammars[$i].name" "$MANIFEST")
  version=$(jq -r ".grammars[$i].version" "$MANIFEST")
  repo=$(jq -r ".grammars[$i].repo" "$MANIFEST")
  wasm_asset=$(jq -r ".grammars[$i].wasm_asset" "$MANIFEST")
  queries_path=$(jq -r ".grammars[$i].queries_path" "$MANIFEST")

  lang_dir="$GRAMMARS_DIR/$lang"
  stamp="$STAMP_DIR/grammar-${lang}.stamp"

  if [[ -f "$lang_dir/parser.wasm" ]] \
     && [[ -f "$lang_dir/highlights.scm" ]] \
     && [[ -f "$stamp" ]] \
     && [[ "$(cat "$stamp")" == "$version" ]]; then
    echo "  embedded grammar $lang $version — up to date"
    continue
  fi

  echo "  Downloading embedded grammar $lang $version..."
  mkdir -p "$lang_dir"

  wasm_url="https://github.com/$repo/releases/download/$version/$wasm_asset"
  if ! curl "${curl_opts[@]}" -o "$lang_dir/parser.wasm" "$wasm_url"; then
    echo "Failed to download $wasm_url" >&2
    exit 1
  fi

  highlights_url="https://raw.githubusercontent.com/$repo/$version/$queries_path"
  if ! curl "${curl_opts[@]}" -o "$lang_dir/highlights.scm" "$highlights_url"; then
    echo "Failed to download $highlights_url" >&2
    exit 1
  fi

  printf '%s' "$version" > "$stamp"
  echo "  embedded grammar $lang $version installed"
done
